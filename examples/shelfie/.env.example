# Copy to .env for local development (orb dev does it). Never commit .env.
# Every variable gorbital reads, with its default and what production
# refuses: docs/guides/environment-variables.md.

# docs:start env
# development or production; required.
APP_ENV=development

# Address the API listens on.
APP_ADDR=127.0.0.1:8080

# PostgreSQL from compose.yaml.
DATABASE_URL=postgres://shelfie:shelfie@127.0.0.1:5432/shelfie?sslmode=disable
# docs:end env

# debug, info, warn or error.
APP_LOG_LEVEL=info

# Comma-separated browser origins of the web app, such as
# https://shelfie.example.com; https only in production.
APP_CORS_ORIGINS=

# How long a request may take before it gets 503 request_timeout; 0 is off.
APP_REQUEST_TIMEOUT=30s

# docs:start ops-allowed-ips
# Client addresses allowed to call /ops/, such as your VPN's range
# (10.8.0.0/16,2001:db8:42::/48). Empty allows every address; behind a load
# balancer, set APP_TRUSTED_PROXIES too.
OPS_ALLOWED_IPS=
# docs:end ops-allowed-ips

# Encrypts two-factor authentication secrets (ADR-0043): comma-separated
# id:base64key entries, each a 32-byte key; the first encrypts and all
# decrypt. Required in production; orb dev fills it in .env when empty.
# Generate a key: echo "k1:$(openssl rand -base64 32)"
AUTH_ENCRYPTION_KEYS=

# docs:start partner-webhook-secret
# The partner bookshop's webhook signing secret (Standard Webhooks:
# whsec_ and base64). Two separated by a comma while the shop rotates it.
# Empty refuses every delivery on /v1/webhooks/partners/purchases.
PARTNER_WEBHOOK_SECRET=
# docs:end partner-webhook-secret
