{
  "info": {
    "name": "mobile-backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": "",
      "description": "Session token for operations that require authentication"
    }
  ],
  "item": [
    {
      "name": "Trips",
      "item": [
        {
          "name": "List your trips",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/trips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "trips"
              ]
            }
          }
        },
        {
          "name": "Add a trip",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "string",
                "description": "A unique value, such as a UUID, that makes retrying this request safe: a retry with the same key and request gets the first response again, with Idempotent-Replayed: true. The same key with another request fails with 422 idempotency_key_reused, and while the first request runs with 409 idempotency_in_progress. Only for signed-in callers; keys and responses are kept for 24 hours by default."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/trips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "trips"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"string\",\n  \"notes\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get one of your trips",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/trips/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "trips",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "trp_mfrggzdfmztwq2lkmfrggzdfmy"
                }
              ]
            }
          }
        },
        {
          "name": "Delete one of your trips",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/trips/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "trips",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "trp_mfrggzdfmztwq2lkmfrggzdfmy"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Build information",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/version",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "version"
              ]
            }
          }
        }
      ]
    }
  ]
}
