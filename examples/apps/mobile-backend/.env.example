# Copy to .env for local development (orb dev does it). Never commit .env.
# Every variable gorbital reads, with its default and what production
# refuses: docs/guides/environment-variables.md.

# docs:start env
# development or production; required.
APP_ENV=development

# Address the API listens on.
APP_ADDR=127.0.0.1:8080

# PostgreSQL from compose.yaml.
DATABASE_URL=postgres://mobile_backend:mobile_backend@127.0.0.1:5432/mobile_backend?sslmode=disable
# docs:end env

# debug, info, warn or error.
APP_LOG_LEVEL=info

# docs:start idp
# The identity provider that signs your users in. The app verifies its
# tokens and stores nothing about the accounts themselves; cmd/api/idp.go
# reads these three and the optional ones below. Every value is public:
# there is no client secret, because the API only verifies signatures.

# The "iss" claim of the provider's tokens, exactly as they spell it,
# including a trailing slash when the provider uses one. Required.
IDP_ISSUER=https://idp.example.com/

# What identifies this API at the provider (its API identifier, audience or
# app client). Several, comma-separated, while you migrate from one to the
# next. A token issued for another API is refused. Required.
IDP_AUDIENCE=https://api.example.com

# Where the provider publishes its public keys: https, or http on a
# loopback address for a provider running locally. Required.
IDP_JWKS_URL=https://idp.example.com/.well-known/jwks.json

# The claim holding the audience, when the provider doesn't use "aud"
# (Cognito access tokens use client_id). Default: aud.
# IDP_AUDIENCE_CLAIM=client_id

# The signature algorithms the provider uses. Default: RS256,ES256,EdDSA.
# IDP_ALGORITHMS=RS256

# The claim holding the caller's permissions, which must be this app's
# permission names: trips.trip.read and trips.trip.write. Default:
# permissions (Auth0's RBAC claim).
# IDP_PERMISSIONS_CLAIM=permissions

# How far a token's times may be from this server's clock, at most 5m.
# Default: 30s.
# IDP_CLOCK_SKEW=30s
# docs:end idp
