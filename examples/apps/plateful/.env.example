# Copy to .env for local development. Never commit .env.
#
# Only secrets and infrastructure live here. Values operators change at
# runtime (like the maximum open orders per restaurant, or the email sender) are runtime
# settings, edited through /ops/settings, and job schedules are edited through
# /ops/jobs.

# development or production; required, so a deployment that forgets it
# doesn't run with development's relaxed checks. Production enables JSON logs,
# HSTS and those checks.
APP_ENV=development

# Address the API listens on.
APP_ADDR=127.0.0.1:8080

# debug, info, warn or error.
APP_LOG_LEVEL=info
# Log encoding: json or text. Empty means JSON in production, text otherwise;
# orb dev sets json for the Dev Portal's log store and prints text.
APP_LOG_FORMAT=
# Where the hourly log archive keeps the current hour before storing it
# gzipped in file storage under logs/ (ADR-0079). Collection is off until
# the logs.archive.enabled runtime setting is on: PUT /ops/settings/logs.archive.enabled.
LOG_ARCHIVE_DIR=.orb/logs

# Serve interactive docs at /docs and the OpenAPI document at /openapi.json:
# true or false. Empty: on in development, off in production.
APP_DOCS_ENABLED=

# Comma-separated browser origins allowed to call the API (CORS), for example
# https://app.example.com; https only in production. Empty disables CORS.
APP_CORS_ORIGINS=

# Comma-separated CIDR ranges or addresses of your load balancers and reverse
# proxies, such as 10.0.0.0/8. Requests from them are attributed to the client
# in X-Forwarded-For, for rate limits, logs and audit events. Empty trusts no
# proxy header (correct when clients connect directly).
APP_TRUSTED_PROXIES=

# Comma-separated CIDR ranges or addresses of gateways and internal services
# that call the API and start traces, such as 10.1.0.0/16. Their X-Request-ID
# and trace context are kept; other clients get a new request ID and trace.
# Match client addresses (after APP_TRUSTED_PROXIES), not your load balancer.
APP_TRUSTED_CALLERS=

# docs:start max-body-bytes
# Largest accepted request body in bytes.
#
# It bounds image uploads too, which is easy to miss: in development the
# local storage driver's signed PUT is served by this same app, so a menu
# photo travels through this limit. Keep it above the images.max_bytes
# runtime setting, or a legal image is refused with 413 before the images
# module sees it. With S3-compatible storage in production the upload goes
# straight to the bucket and this doesn't apply.
APP_MAX_BODY_BYTES=16777216
# docs:end max-body-bytes

# How long a request may take before it gets 503 request_timeout; 0 is off.
# Streaming responses aren't cut off.
APP_REQUEST_TIMEOUT=30s

# Client addresses allowed to call /ops/, such as your VPN's range
# (10.8.0.0/16,2001:db8:42::/48). Empty allows every address; behind a load
# balancer, set APP_TRUSTED_PROXIES too.
OPS_ALLOWED_IPS=

# OpenTelemetry export. Set an OTLP endpoint to send traces and metrics,
# for example http://localhost:4318. Empty keeps telemetry local.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Prometheus metrics: host:port of a separate listener serving /metrics, for
# example 127.0.0.1:9464. No authentication: bind it to an interface only
# your Prometheus reaches, never a public one. Must not use APP_ADDR's port.
# Empty: off.
METRICS_ADDR=

# Development console APIs under /_dev/ (docs/guides/dev-console.md): recent
# requests and logs, routes, configuration without secrets and more, for
# local tools. A random token of at least 32 characters turns them on when
# APP_ENV is development; requests need it as a bearer token and a localhost
# address. orb dev sets a new token on every run and prints it, so leave this
# empty. Refused in production.
DEV_CONSOLE_TOKEN=

# PostgreSQL, from compose.yaml in development. In production use a secret
# (DATABASE_URL_FILE is also supported).
DATABASE_URL=postgres://plateful:plateful@127.0.0.1:5432/plateful?sslmode=disable

# Host port for the development database in compose.yaml.
POSTGRES_PORT=5432

# Maximum database connections per instance.
APP_DB_MAX_CONNS=10

# Jobs worked at the same time per instance.
APP_JOB_WORKERS=10

# Encrypts two-factor authentication secrets (ADR-0043): comma-separated
# id:base64key entries, each a 32-byte key; the first encrypts and all
# decrypt. Required in production; orb dev fills it in .env when empty.
# Generate a key: echo "k1:$(openssl rand -base64 32)"
AUTH_ENCRYPTION_KEYS=

# Passkeys (ADR-0044). What each value is and where to find it: AUTH_PROVIDERS.md.
# Development: leave empty for localhost, and open http://localhost:8080 (not
# 127.0.0.1). Production: empty turns passkeys off; origins must use https.
# Your site's domain, such as example.com.
WEBAUTHN_RP_ID=
# Comma-separated browser origins of your frontend, such as https://app.example.com.
WEBAUTHN_ORIGINS=
# iOS apps: comma-separated TEAMID.bundle.id (Apple Developer → Membership
# details → Team ID, plus the app's bundle ID).
WEBAUTHN_APPLE_APP_IDS=
# Android apps: comma-separated package.name=SHA256:FINGERPRINT (Play Console →
# App integrity → App signing key certificate → SHA-256).
WEBAUTHN_ANDROID_APPS=

# The API's public URL, which Google, Apple and GitHub return to
# (/v1/auth/{google,apple,github}/callback). Development: empty means
# http://localhost:8080. Production: required with Google, Apple or GitHub, https.
APP_PUBLIC_URL=
# Where a browser sign-in with Google, Apple or GitHub ends when your frontend
# names no return_to, such as https://app.example.com/signed-in: on
# APP_PUBLIC_URL or an APP_CORS_ORIGINS origin. Development: empty means the
# API docs. Production: required with any of them (docs are off there).
# AUTH_PROVIDERS.md#after-signing-in.
AUTH_DEFAULT_RETURN_TO=

# Google sign-in (ADR-0046). Step by step: AUTH_PROVIDERS.md#google-sign-in.
# Google Cloud Console → Google Auth Platform → Clients → Web application; add
# the redirect URI <APP_PUBLIC_URL>/v1/auth/google/callback.
GOOGLE_CLIENT_ID=
# Secret (GOOGLE_CLIENT_SECRET_FILE also works). Shown when the client is created.
GOOGLE_CLIENT_SECRET=
# Optional: the iOS and Android client IDs your apps' ID tokens are issued for.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Apple sign-in (ADR-0046). Step by step: AUTH_PROVIDERS.md#apple-sign-in.
# Apple Developer → Membership details → Team ID.
APPLE_TEAM_ID=
# Identifiers → Services IDs (web), with the return URL
# <APP_PUBLIC_URL>/v1/auth/apple/callback. Empty for iOS apps only.
APPLE_SERVICES_ID=
# Keys → a Sign in with Apple key: its Key ID, and the .p8 file downloaded once.
APPLE_KEY_ID=
# Secret: an absolute path outside the repository (or APPLE_PRIVATE_KEY with the contents).
APPLE_PRIVATE_KEY_FILE=
# Comma-separated bundle IDs of your iOS apps.
APPLE_BUNDLE_IDS=

# GitHub sign-in (ADR-0059). Step by step: AUTH_PROVIDERS.md#github-sign-in.
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App; the
# authorization callback URL is <APP_PUBLIC_URL>/v1/auth/github/callback.
GITHUB_CLIENT_ID=
# Secret (GITHUB_CLIENT_SECRET_FILE also works). Generate a new client secret
# on the app's page; GitHub shows it once.
GITHUB_CLIENT_SECRET=

# Email delivery: devmail sends every email to orb dev's mail catcher, read
# in the Dev Portal's Mail screen; mailpit sends to a Mailpit inbox you run
# (MAILPIT_SMTP_ADDR, default 127.0.0.1:1025); provider sends real email.
# Empty means devmail in development and provider in production.
MAIL_DELIVERY=

# Where orb dev's mail catcher listens (ADR-0074).
DEV_MAIL_SMTP_ADDR=127.0.0.1:1025

# orb:begin storage
# File storage (ADR-0075): local keeps files under STORAGE_LOCAL_DIR on this
# machine (development only); s3, spaces, r2 and minio are S3-compatible
# services, set up with `orb add storage`. Production refuses local.
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=.orb/storage
# For s3, spaces, r2 and minio: the endpoint (s3 and spaces derive it from
# the region), region, bucket and keys; STORAGE_PUBLIC_URL when the bucket
# is public; STORAGE_PATH_STYLE=true for MinIO (the default there).
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
STORAGE_PATH_STYLE=
# Signs local storage's download and upload links; random at each start
# when empty.
STORAGE_SIGNING_KEY=
# orb:end storage

# Host ports of Grafana and its OTLP receiver in compose.yaml, for
# orb dev --observability.
GRAFANA_PORT=3000
OTLP_HTTP_PORT=4318

# orb:begin mail (managed by `orb add mail`: the email provider's secrets)
# Resend API key, from https://resend.com/api-keys. Needed when email goes
# through Resend (always in production). The sender name, address and
# reply-to are runtime settings: PUT /ops/settings/mail.from_email.
RESEND_API_KEY=
# Signing secret (whsec_…) of the webhook for bounces and complaints, from
# Resend's webhook settings, pointing at https://<your API>/v1/webhooks/resend.
# Optional: without it the webhook answers 404 and no address is suppressed.
RESEND_WEBHOOK_SECRET=
# orb:end mail

# docs:start payments-webhook-secret
# The payment provider's webhook signing secret (Standard Webhooks: whsec_
# and base64), or two separated by a comma while it is rotated. Empty
# refuses every delivery on /v1/webhooks/payments.
# PAYMENTS_WEBHOOK_SECRET_FILE=/run/secrets/... works too.
PAYMENTS_WEBHOOK_SECRET=
# docs:end payments-webhook-secret
