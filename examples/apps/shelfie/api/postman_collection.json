{
  "info": {
    "name": "shelfie",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": "",
      "description": "Session token for operations that require authentication"
    }
  ],
  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "List your books",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "books"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "want_to_read",
                  "description": "Only books with this status",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "How many books to return, newest first",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Add a book to your shelf",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "string",
                "description": "A unique value, such as a UUID, that makes retrying this request safe: a retry with the same key and request gets the first response again, with Idempotent-Replayed: true. The same key with another request fails with 422 idempotency_key_reused, and while the first request runs with 409 idempotency_in_progress. Only for signed-in callers; keys and responses are kept for 24 hours by default."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"string\",\n  \"author\": \"string\",\n  \"isbn\": \"string\",\n  \"status\": \"want_to_read\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get a book",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/books/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "books",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "bok_mfrggzdfmztwq2lkmfrggzdfmy"
                }
              ]
            }
          }
        },
        {
          "name": "Change a book",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "string",
                "description": "A unique value, such as a UUID, that makes retrying this request safe: a retry with the same key and request gets the first response again, with Idempotent-Replayed: true. The same key with another request fails with 422 idempotency_key_reused, and while the first request runs with 409 idempotency_in_progress. Only for signed-in callers; keys and responses are kept for 24 hours by default."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/books/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "books",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "bok_mfrggzdfmztwq2lkmfrggzdfmy"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"string\",\n  \"isbn\": \"string\",\n  \"status\": \"want_to_read\",\n  \"title\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Remove a book",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/books/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "books",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "bok_mfrggzdfmztwq2lkmfrggzdfmy"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Build information",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/version",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "version"
              ]
            }
          }
        }
      ]
    }
  ]
}
