          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Change a book",
        "tags": [
          "Books"
        ],
        "x-gorbital-guards": [
          "authenticated",
          "permission:books.book.write"
        ]
      }
    },
    "/v1/shelves": {
      "get": {
        "description": "Newest first unless `sort` says otherwise; sort by one of `created_at`, `updated_at` or `name`. Paginate with `cursor`.",
        "operationId": "shelves-list",
        "parameters": [
          {
            "description": "Maximum number of items to return (default 20, max 100)",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Maximum number of items to return (default 20, max 100)",
              "format": "int64",
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from a previous response's next_cursor",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from a previous response's next_cursor",
              "maxLength": 512,
              "type": "string"
            }
          },
          {
            "description": "Comma-separated sort fields; prefix a field with - for descending order",
            "explode": false,
            "in": "query",
            "name": "sort",
            "schema": {
              "description": "Comma-separated sort fields; prefix a field with - for descending order",
              "examples": [
                "-created_at"
              ],
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "description": "Only shelves with this visibility",
            "explode": false,
            "in": "query",
            "name": "visibility",
            "schema": {
              "description": "Only shelves with this visibility",
              "enum": [
                "private",
                "shared"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShelfPage"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List your shelves",
        "tags": [
          "Shelves"
        ],
        "x-gorbital-guards": [
          "authenticated",
          "permission:shelves.shelf.read"
        ]
      },
      "post": {
        "operationId": "shelves-create",
        "parameters": [
          {
            "description": "A unique value, such as a UUID, that makes retrying this request safe: a retry with the same key and request gets the first response again, with `Idempotent-Replayed: true`. The same key with another request fails with 422 `idempotency_key_reused`, and while the first request runs with 409 `idempotency_in_progress`. Only for signed-in callers; keys and responses are kept for 24 hours by default.",
            "example": "7f1e9c4a-4f5b-4c1e-9a55-2d1d7c2b8e61",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[!-~]+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShelfInputBody"
              }
            }
