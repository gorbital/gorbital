# Copy to .env for local development (orb dev does it). Never commit .env.
# Every variable gorbital reads, with its default and what production
# refuses: docs/guides/environment-variables.md.

# development or production; required.
APP_ENV=development

# Address the API listens on.
APP_ADDR=127.0.0.1:8080

# PostgreSQL from compose.yaml.
DATABASE_URL=postgres://payments:payments@127.0.0.1:5432/payments?sslmode=disable

# debug, info, warn or error.
APP_LOG_LEVEL=info

# docs:start webhook-secret
# The payment provider's signing secret, from its dashboard: "whsec_"
# followed by base64. Without it the app starts, but every delivery is
# refused with 401 invalid_webhook_signature.
#
# To rotate it, list both while the provider switches over: add the new one
# first, deploy, change the secret in the provider's dashboard, then deploy
# again without the old one.
#
#   PAYMENTS_WEBHOOK_SECRET=whsec_<new>,whsec_<old>
#
# PAYMENTS_WEBHOOK_SECRET_FILE=/run/secrets/payments_webhook_secret reads it
# from a file instead, for Docker and Kubernetes secrets. Setting both fails
# at startup.
#
# For local development, make one up: echo "whsec_$(openssl rand -base64 24)"
PAYMENTS_WEBHOOK_SECRET=
# docs:end webhook-secret
