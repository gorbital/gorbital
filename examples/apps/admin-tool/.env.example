# Copy to .env for local development (orb dev does it). Never commit .env.
# Every variable gorbital reads, with its default and what production
# refuses: docs/guides/environment-variables.md.

# docs:start env
# development or production; required.
APP_ENV=development

# Address the API listens on.
APP_ADDR=127.0.0.1:8080

# PostgreSQL from compose.yaml.
DATABASE_URL=postgres://admin_tool:admin_tool@127.0.0.1:5432/admin_tool?sslmode=disable
# docs:end env

# debug, info, warn or error.
APP_LOG_LEVEL=info

# docs:start ops-network
# Client addresses allowed to call /ops/: your office's or VPN's ranges and
# addresses, comma-separated. Other addresses get 403 ip_not_allowed before
# the sign-in check. Empty allows every address. Uncomment in production:
# OPS_ALLOWED_IPS=10.8.0.0/16,2001:db8:42::/48,203.0.113.7

# Load balancers and reverse proxies whose X-Forwarded-For names the client.
# OPS_ALLOWED_IPS is matched against the address after them: behind a load
# balancer, without this, every request has the balancer's address.
APP_TRUSTED_PROXIES=
# docs:end ops-network
