{
  "components": {
    "schemas": {
      "EchoInputBody": {
        "additionalProperties": true,
        "properties": {
          "message": {
            "description": "Message to echo back",
            "examples": [
              "hello"
            ],
            "maxLength": 500,
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred",
            "examples": [
              "body.name"
            ],
            "type": "string"
          },
          "message": {
            "description": "What is wrong",
            "examples": [
              "expected length \u003e= 1"
            ],
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Info": {
        "additionalProperties": false,
        "properties": {
          "build_time": {
            "examples": [
              "2026-09-14T12:00:00Z"
            ],
            "type": "string"
          },
          "commit": {
            "examples": [
              "3f9a1c2b7d4e"
            ],
            "type": "string"
          },
          "go_version": {
            "examples": [
              "go1.25.3"
            ],
            "type": "string"
          },
          "modified": {
            "type": "boolean"
          },
          "version": {
            "examples": [
              "v1.2.3"
            ],
            "type": "string"
          }
        },
        "required": [
          "version",
          "go_version"
        ],
        "type": "object"
      },
      "MessageResponse": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "description": "Message text",
            "examples": [
              "pong"
            ],
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable machine-readable error code",
            "examples": [
              "project_name_taken"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Human-readable explanation",
            "examples": [
              "project name is already taken"
            ],
            "type": "string"
          },
          "errors": {
            "description": "Field-level validation errors",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "request_id": {
            "description": "Correlates with server logs and traces",
            "examples": [
              "req_9f86d081884c7d65"
            ],
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              409
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem type",
            "examples": [
              "Conflict"
            ],
            "type": "string"
          },
          "type": {
            "description": "URI identifying the problem type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "code"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "acme-api",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/echo": {
      "post": {
        "description": "Returns the trimmed message. Blank messages are rejected with the `message_required` error code.",
        "operationId": "echo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EchoInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Echo a message",
        "tags": [
          "Example"
        ]
      }
    },
    "/v1/ping": {
      "get": {
        "operationId": "ping",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Check the API is reachable",
        "tags": [
          "Example"
        ]
      }
    },
    "/version": {
      "get": {
        "operationId": "get-version",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Build information",
        "tags": [
          "System"
        ]
      }
    }
  }
}
