
# Binaries the tools build when run with `go build` in their own directory.
internal/tools/apicheck/apicheck
internal/tools/docscheck/docscheck
internal/tools/refdocs/refdocs
internal/tools/contracts/contracts

# The showcase applications' repository, fetched by scripts/examples.sh at
# the ref docs/examples.json pins, so that docscheck can resolve the
# <!-- include examples/apps/... --> markers (ADR-0093).
/.examples/

# The gitleaks scan's report, written by a local or CI secret scan. It
# names every file and line a rule matched, so it stays out of the tree.
/.gitleaks-report.json
