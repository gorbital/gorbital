{
  "info": {
    "name": "⟦.Name⟧",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": "",
      "description": "Session token for operations that require authentication"
    }
  ],
  "item": [
    {
      "name": "Example",
      "item": [
        {
          "name": "Echo a message",
          "request": {
            "method": "POST",
            "description": "Returns the trimmed message. Blank messages are rejected with the `message_required` error code.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/echo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "echo"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"hello\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Check the API is reachable",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ping"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Build information",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/version",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "version"
              ]
            }
          }
        }
      ]
    }
  ]
}
