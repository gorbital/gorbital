package app

import (
	"fmt"
	"net/http"

	"github.com/danielgtaylor/huma/v2"

	"apistock.dev/httpx"

	projectsmodule "⟦.Module⟧/internal/modules/projects"
	projectsdomain "⟦.Module⟧/internal/modules/projects/domain"
	projectsusecase "⟦.Module⟧/internal/modules/projects/usecase"
)

// registerProjects builds and wires the projects module. Error codes are
// public API: add new ones, never change existing ones. Organisation and
// permission errors are mapped in module_orgs.go.
func registerProjects(api huma.API, mapper *httpx.Mapper, svc services) error {
	err := mapper.Add(
		httpx.Mapping{Err: projectsdomain.ErrInvalidProject, Status: http.StatusUnprocessableEntity, Code: "validation_failed", Detail: "the project is not valid"},
		httpx.Mapping{Err: projectsdomain.ErrProjectNotFound, Status: http.StatusNotFound, Code: "project_not_found", Detail: "the organisation has no project with this ID"},
		httpx.Mapping{Err: projectsdomain.ErrProjectNameTaken, Status: http.StatusConflict, Code: "project_name_taken", Detail: "the organisation already has a project with this name"},
		httpx.Mapping{Err: projectsdomain.ErrProjectVersionConflict, Status: http.StatusConflict, Code: "project_version_conflict", Detail: "the project changed since you read it; get it again and retry"},
	)
	if err != nil {
		return fmt.Errorf("projects module: %w", err)
	}
	// Without a database, when exporting the OpenAPI document, the operations
	// are registered without their dependencies.
	var m *projectsmodule.Module
	if svc.db != nil {
		orgs := svc.orgs.Service()
		m, err = projectsmodule.New(svc.db, projectsusecase.Config{
			Recorder: svc.recorder, Logger: svc.logger,
			Catalog: orgs.Catalog(), Memberships: orgs.Memberships(),
		})
		if err != nil {
			return fmt.Errorf("projects module: %w", err)
		}
	}
	m.Register(api)
	return nil
}
