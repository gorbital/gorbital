package domain_test⟦$t := .Title⟧⟦$e := .FirstEnum⟧

import (
	"errors"
	"slices"
	"strings"
	"testing"
	"time"

	⟦.Package⟧domain "⟦.Module⟧/internal/modules/⟦.Package⟧/domain"
)

var now = time.Date(2026, 9, 15, 12, 0, 0, 0, time.UTC)

// validFields returns fields that pass every rule.
func validFields() ⟦.Package⟧domain.⟦.Ident⟧Fields {
	return ⟦.Package⟧domain.⟦.Ident⟧Fields{⟦.SampleFields ""⟧}
}

func TestNew⟦.Ident⟧(t *testing.T) {
	f := validFields()
⟦- range .TextFields⟧
	f.⟦.Ident⟧ = "  " + f.⟦.Ident⟧ + "  "
⟦- end⟧
⟦- range .Enums⟧
	f.⟦.Ident⟧ = ""
⟦- end⟧
	p, err := ⟦.Package⟧domain.New⟦.Ident⟧("⟦.IDPrefix⟧_1", "usr_1", f, now)
	if err != nil {
		t.Fatal(err)
	}
	if p.⟦.Ident⟧Fields != validFields() || p.ID != "⟦.IDPrefix⟧_1" || p.OwnerID != "usr_1" || p.Version != 1 ||
		!p.CreatedAt.Equal(now) || !p.UpdatedAt.Equal(now) {
		t.Errorf("New⟦.Ident⟧() = %+v, want trimmed text⟦if .HasEnums⟧ and default choices⟦end⟧", p)
	}
}

func TestNew⟦.Ident⟧Validates(t *testing.T) {
	type fields = ⟦.Package⟧domain.⟦.Ident⟧Fields
	tests := []struct {
		name       string
		edit       func(f *fields)
		wantFields []string
	}{
⟦- range .Fields⟧
⟦- if .IsEnum⟧
		{"unknown ⟦.Human⟧", func(f *fields) { f.⟦.Ident⟧ = "?" }, []string{⟦quote .Name⟧}},
⟦- else⟧
⟦- if eq .MinLength 1⟧
		{"blank ⟦.Human⟧", func(f *fields) { f.⟦.Ident⟧ = "   " }, []string{⟦quote .Name⟧}},
⟦- end⟧
		{"⟦.Human⟧ at the limit", func(f *fields) { f.⟦.Ident⟧ = strings.Repeat("é", ⟦$.Package⟧domain.Max⟦.Ident⟧Length) }, nil},
		{"⟦.Human⟧ too long", func(f *fields) { f.⟦.Ident⟧ = strings.Repeat("é", ⟦$.Package⟧domain.Max⟦.Ident⟧Length+1) }, []string{⟦quote .Name⟧}},
		{"⟦.Human⟧ with a NUL character", func(f *fields) { f.⟦.Ident⟧ = "ok\x00" }, []string{⟦quote .Name⟧}},
⟦- end⟧
⟦- end⟧
		{"every field invalid", func(f *fields) { *f = fields{⟦.InvalidFields⟧} }, ⟦.FieldNames⟧},
	}
	for _, tt := range tests {
		f := validFields()
		tt.edit(&f)
		_, err := ⟦.Package⟧domain.New⟦.Ident⟧("⟦.IDPrefix⟧_1", "usr_1", f, now)
		if tt.wantFields == nil {
			if err != nil {
				t.Errorf("%s: New⟦.Ident⟧() error = %v", tt.name, err)
			}
			continue
		}
		var invalid *⟦.Package⟧domain.ValidationError
		if !errors.As(err, &invalid) || !errors.Is(err, ⟦.Package⟧domain.ErrInvalid⟦.Ident⟧) {
			t.Errorf("%s: New⟦.Ident⟧() error = %v, want a ValidationError", tt.name, err)
			continue
		}
		var got []string
		for _, fe := range invalid.Errors {
			got = append(got, fe.Field)
		}
		if !slices.Equal(got, tt.wantFields) {
			t.Errorf("%s: invalid fields = %v, want %v", tt.name, got, tt.wantFields)
		}
	}
}

func TestApply(t *testing.T) {
	p, err := ⟦.Package⟧domain.New⟦.Ident⟧("⟦.IDPrefix⟧_1", "usr_1", validFields(), now)
	if err != nil {
		t.Fatal(err)
	}
	later := now.Add(time.Hour)
	title, same, blank := " "+p.⟦$t.Ident⟧+" v2 ", p.⟦$t.Ident⟧, ""
⟦- if .HasEnums⟧
	choice := ⟦.Package⟧domain.⟦$e.Ident⟧⟦$e.LastValue.Ident⟧
⟦- end⟧

	next, changed, err := p.Apply(⟦.Package⟧domain.Changes{⟦$t.Ident⟧: &title⟦if .HasEnums⟧, ⟦$e.Ident⟧: &choice⟦end⟧}, later)
	if err != nil || next.⟦$t.Ident⟧ != p.⟦$t.Ident⟧+" v2"⟦if .HasEnums⟧ || next.⟦$e.Ident⟧ != choice⟦end⟧ || !next.UpdatedAt.Equal(later) ||
		!slices.Equal(changed, ⟦.ChangedNames⟧) {
		t.Errorf("Apply() = %+v, %v, %v", next, changed, err)
	}

	unchanged, changed, err := p.Apply(⟦.Package⟧domain.Changes{⟦$t.Ident⟧: &same}, later)
	if err != nil || len(changed) != 0 || unchanged != p {
		t.Errorf("Apply(same ⟦$t.Human⟧) = %+v, %v, %v; want no change", unchanged, changed, err)
	}

	kept, _, err := p.Apply(⟦.Package⟧domain.Changes{⟦$t.Ident⟧: &blank}, later)
	if !errors.Is(err, ⟦.Package⟧domain.ErrInvalid⟦.Ident⟧) || kept != p {
		t.Errorf("Apply(blank ⟦$t.Human⟧) = %+v, %v; want the original and a validation error", kept, err)
	}
}
