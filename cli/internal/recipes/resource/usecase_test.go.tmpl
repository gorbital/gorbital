}

func TestRequiresSignedInUser(t *testing.T) {
	f := newFixture(t)
	p := f.create(t, "usr_ada", "Website")
	for name, ctx := range map[string]context.Context{
		"no actor":  context.Background(),
		"anonymous": actor.With(context.Background(), actor.Anonymous),
		"system":    actor.With(context.Background(), actor.System("cli")),
	} {
		_, createErr := f.svc.Create(ctx, validFields())
		_, getErr := f.svc.Get(ctx, p.ID)
		_, listErr := f.svc.List(ctx, ⟦.Package⟧usecase.ListInput{})
		_, updateErr := f.svc.Update(ctx, p.ID, ⟦.Package⟧usecase.UpdateInput{Version: 1})
		deleteErr := f.svc.Delete(ctx, p.ID)
		for op, err := range map[string]error{"Create": createErr, "Get": getErr, "List": listErr, "Update": updateErr, "Delete": deleteErr} {
			if !errors.Is(err, ⟦.Package⟧domain.ErrUnauthenticated) {
				t.Errorf("%s with %s error = %v, want ErrUnauthenticated", op, name, err)
			}
		}
	}
}

func TestCreate(t *testing.T) {
	f := newFixture(t)
	fields := validFields()
	fields.⟦$t.Ident⟧ = " " + fields.⟦$t.Ident⟧ + " "
	p, err := f.svc.Create(as("usr_ada"), fields)
	if err != nil || p.ID != "⟦.IDPrefix⟧_1" || p.OwnerID != "usr_ada" || p.⟦$t.Ident⟧ != strings.TrimSpace(fields.⟦$t.Ident⟧) ||
		p.Version != 1 || !p.CreatedAt.Equal(f.now) {
		t.Fatalf("Create() = %+v, %v", p, err)
	}
	if got, err := f.svc.Get(as("usr_ada"), p.ID); err != nil || got != p {
		t.Errorf("Get() = %+v, %v, want %+v", got, err, p)
	}

	_, err = f.svc.Create(as("usr_ada"), ⟦.Package⟧domain.⟦.Ident⟧Fields{⟦.InvalidFields⟧})
	var invalid *⟦.Package⟧domain.ValidationError
	if !errors.As(err, &invalid) || len(invalid.Errors) != ⟦len .Fields⟧ {
		t.Errorf("Create(invalid) error = %v, want ⟦len .Fields⟧ invalid fields", err)
	}
⟦- if .HasUniques⟧
	taken := validFields()
⟦- range .Uniques⟧⟦if ne .Name $u.Name⟧
	taken.⟦.Ident⟧ = "Other ⟦.Human⟧"
⟦- end⟧⟦end⟧
	taken.⟦$u.Ident⟧ = strings.ToUpper(p.⟦$u.Ident⟧)
	if _, err := f.svc.Create(as("usr_ada"), taken); !errors.Is(err, ⟦.Package⟧domain.Err⟦.Ident⟧⟦$u.Ident⟧Taken) {
		t.Errorf("Create(taken ⟦$u.Human⟧) error = %v, want Err⟦.Ident⟧⟦$u.Ident⟧Taken", err)
	}
⟦- end⟧
	if want := []string{⟦.Package⟧usecase.ActionCreated + " ⟦.IDPrefix⟧_1"}; !slices.Equal(f.audit.actions(), want) {
		t.Errorf("audit = %v, want %v", f.audit.actions(), want)
	}
}

// TestOwnersCantReachEachOthers⟦.Plural⟧ is the cross-owner isolation test
// every generated resource gets (ADR-0039).
func TestOwnersCantReachEachOthers⟦.Plural⟧(t *testing.T) {
	f := newFixture(t)
	p := f.create(t, "usr_ada", "Website")
	bob := as("usr_bob")
	title := "Stolen"

	if _, err := f.svc.Get(bob, p.ID); !errors.Is(err, ⟦.Package⟧domain.Err⟦.Ident⟧NotFound) {
		t.Errorf("Get(another owner's) error = %v, want Err⟦.Ident⟧NotFound", err)
	}
	if _, err := f.svc.Update(bob, p.ID, ⟦.Package⟧usecase.UpdateInput{Version: p.Version, Changes: ⟦.Package⟧domain.Changes{⟦$t.Ident⟧: &title}}); !errors.Is(err, ⟦.Package⟧domain.Err⟦.Ident⟧NotFound) {
		t.Errorf("Update(another owner's) error = %v, want Err⟦.Ident⟧NotFound", err)
	}
	if err := f.svc.Delete(bob, p.ID); !errors.Is(err, ⟦.Package⟧domain.Err⟦.Ident⟧NotFound) {
		t.Errorf("Delete(another owner's) error = %v, want Err⟦.Ident⟧NotFound", err)
	}
	if res, err := f.svc.List(bob, ⟦.Package⟧usecase.ListInput{}); err != nil || len(res.Items) != 0 {
		t.Errorf("List() for another owner = %+v, %v, want none", res, err)
	}
	if got, err := f.svc.Get(as("usr_ada"), p.ID); err != nil || got != p {
		t.Errorf("⟦.Human⟧ changed by another owner: %+v, %v", got, err)
	}
}

func TestUpdate(t *testing.T) {
	f := newFixture(t)
	ctx := as("usr_ada")
	p := f.create(t, "usr_ada", "Website")
	f.create(t, "usr_ada", "Docs")
	f.now = f.now.Add(time.Hour)
	title := "Website v2"
⟦- if .HasEnums⟧
	choice := ⟦.Package⟧domain.⟦$e.Ident⟧⟦$e.LastValue.Ident⟧
⟦- end⟧

	updated, err := f.svc.Update(ctx, p.ID, ⟦.Package⟧usecase.UpdateInput{Version: 1, Changes: ⟦.Package⟧domain.Changes{⟦$t.Ident⟧: &title⟦if .HasEnums⟧, ⟦$e.Ident⟧: &choice⟦end⟧}})
	if err != nil || updated.Version != 2 || updated.⟦$t.Ident⟧ != title⟦if .HasEnums⟧ || updated.⟦$e.Ident⟧ != choice⟦end⟧ || !updated.UpdatedAt.Equal(f.now) {
		t.Fatalf("Update() = %+v, %v", updated, err)
	}
	if _, err := f.svc.Update(ctx, p.ID, ⟦.Package⟧usecase.UpdateInput{Version: 1, Changes: ⟦.Package⟧domain.Changes{⟦$t.Ident⟧: &title}}); !errors.Is(err, ⟦.Package⟧domain.Err⟦.Ident⟧VersionConflict) {
		t.Errorf("Update(stale version) error = %v, want Err⟦.Ident⟧VersionConflict", err)
	}
	same, err := f.svc.Update(ctx, p.ID, ⟦.Package⟧usecase.UpdateInput{Version: 2, Changes: ⟦.Package⟧domain.Changes{⟦$t.Ident⟧: &title}})
	if err != nil || same != updated {
		t.Errorf("Update(no change) = %+v, %v, want the ⟦.Human⟧ unchanged", same, err)
	}
	blank := " "
	if _, err := f.svc.Update(ctx, p.ID, ⟦.Package⟧usecase.UpdateInput{Version: 2, Changes: ⟦.Package⟧domain.Changes{⟦$t.Ident⟧: &blank}}); !errors.Is(err, ⟦.Package⟧domain.ErrInvalid⟦.Ident⟧) {
		t.Errorf("Update(blank ⟦$t.Human⟧) error = %v, want ErrInvalid⟦.Ident⟧", err)
	}
⟦- if .HasUniques⟧
	taken := ⟦if eq $u.Name $t.Name⟧"docs"⟦else⟧⟦quote (print "docs " $u.Human)⟧⟦end⟧
	if _, err := f.svc.Update(ctx, p.ID, ⟦.Package⟧usecase.UpdateInput{Version: 2, Changes: ⟦.Package⟧domain.Changes{⟦$u.Ident⟧: &taken}}); !errors.Is(err, ⟦.Package⟧domain.Err⟦.Ident⟧⟦$u.Ident⟧Taken) {
		t.Errorf("Update(taken ⟦$u.Human⟧) error = %v, want Err⟦.Ident⟧⟦$u.Ident⟧Taken", err)
	}
⟦- end⟧
	if _, err := f.svc.Update(ctx, "⟦.IDPrefix⟧_missing", ⟦.Package⟧usecase.UpdateInput{Version: 1}); !errors.Is(err, ⟦.Package⟧domain.Err⟦.Ident⟧NotFound) {
		t.Errorf("Update(missing) error = %v, want Err⟦.Ident⟧NotFound", err)
	}

	// Only the real change is audited, with field names and no values.
	want := []string{⟦.Package⟧usecase.ActionCreated + " ⟦.IDPrefix⟧_1", ⟦.Package⟧usecase.ActionCreated + " ⟦.IDPrefix⟧_2", ⟦.Package⟧usecase.ActionUpdated + " ⟦.IDPrefix⟧_1"}
	if !slices.Equal(f.audit.actions(), want) {
		t.Fatalf("audit = %v, want %v", f.audit.actions(), want)
	}
	if fields := f.audit.events[2].Metadata["fields"]; !slices.Equal(fields.([]string), ⟦.ChangedNames⟧) {
		t.Errorf("update event fields = %v", fields)
	}
}

