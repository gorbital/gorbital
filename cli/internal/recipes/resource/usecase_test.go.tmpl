func TestListPages(t *testing.T) {
	f := newFixture(t)
	ctx := as("usr_ada")
	for _, title := range []string{"beta", "Alpha", "gamma", "delta", "Epsilon"} {
		f.create(t, "usr_ada", title)
		f.now = f.now.Add(time.Minute)
	}

	titles := func(in ⟦.Package⟧usecase.ListInput) []string {
		t.Helper()
		var got []string
		for range 10 {
			res, err := f.svc.List(ctx, in)
			if err != nil {
				t.Fatalf("List(%+v) error = %v", in, err)
			}
			for _, p := range res.Items {
				got = append(got, p.⟦$t.Ident⟧)
			}
			if res.NextCursor == "" {
				return got
			}
			in.Page.Cursor = res.NextCursor
		}
		t.Fatalf("List(%+v) didn't end", in)
		return nil
	}
	if got, want := titles(⟦.Package⟧usecase.ListInput{Page: page.Params{Limit: 2}}), []string{"Epsilon", "delta", "gamma", "Alpha", "beta"}; !slices.Equal(got, want) {
		t.Errorf("default sort = %v, want newest first %v", got, want)
	}
	if got, want := titles(⟦.Package⟧usecase.ListInput{Page: page.Params{Limit: 2, Sort: ⟦quote $t.Name⟧}}), []string{"Alpha", "beta", "delta", "Epsilon", "gamma"}; !slices.Equal(got, want) {
		t.Errorf("sort=⟦$t.Name⟧ = %v, want %v", got, want)
	}
	if got, want := titles(⟦.Package⟧usecase.ListInput{Page: page.Params{Limit: 5, Sort: ⟦quote (print "-" $t.Name)⟧}}), []string{"gamma", "Epsilon", "delta", "beta", "Alpha"}; !slices.Equal(got, want) {
		t.Errorf("sort=-⟦$t.Name⟧, one full page = %v, want %v", got, want)
	}
⟦- if .HasEnums⟧
	choice := ⟦.Package⟧domain.⟦$e.Ident⟧⟦$e.LastValue.Ident⟧
	if _, err := f.svc.Update(ctx, "⟦.IDPrefix⟧_1", ⟦.Package⟧usecase.UpdateInput{Version: 1, Changes: ⟦.Package⟧domain.Changes{⟦$e.Ident⟧: &choice}}); err != nil {
		t.Fatal(err)
	}
	if got, want := titles(⟦.Package⟧usecase.ListInput{Page: page.Params{Sort: "-updated_at"}, ⟦$e.Ident⟧: choice}), []string{"beta"}; !slices.Equal(got, want) {
		t.Errorf("⟦$e.Name⟧=%s = %v, want %v", choice, got, want)
	}
⟦- end⟧

	first, err := f.svc.List(ctx, ⟦.Package⟧usecase.ListInput{Page: page.Params{Limit: 2}})
	if err != nil {
		t.Fatal(err)
	}
	for _, tt := range []struct {
		params page.Params
		want   error
	}{
		{page.Params{Cursor: first.NextCursor, Sort: ⟦quote $t.Name⟧}, page.ErrInvalidCursor},
		{page.Params{Cursor: "not a cursor"}, page.ErrInvalidCursor},
		{page.Params{Sort: "owner_id"}, page.ErrInvalidSort},
		{page.Params{Sort: ⟦quote (print $t.Name ",created_at")⟧}, page.ErrInvalidSort},
		{page.Params{Limit: 101}, page.ErrInvalidLimit},
	} {
		if _, err := f.svc.List(ctx, ⟦.Package⟧usecase.ListInput{Page: tt.params}); !errors.Is(err, tt.want) {
			t.Errorf("List(%+v) error = %v, want %v", tt.params, err, tt.want)
		}
	}
⟦- if .HasEnums⟧
	if _, err := f.svc.List(ctx, ⟦.Package⟧usecase.ListInput{⟦$e.Ident⟧: "?"}); !errors.Is(err, ⟦.Package⟧domain.ErrInvalid⟦.Ident⟧) {
		t.Errorf("List(unknown ⟦$e.Human⟧) error = %v, want ErrInvalid⟦.Ident⟧", err)
	}
⟦- end⟧
}
