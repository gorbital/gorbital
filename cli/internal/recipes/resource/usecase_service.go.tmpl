// Config holds the Service's dependencies.
type Config struct {
	// Required.
	Store    Store
	Recorder audit.Recorder
⟦- if .Org⟧
	// Catalog is the org catalog and Memberships reads members, both from
	// the orgs module.
	Catalog     *authlib.Catalog
	Memberships orgslib.Memberships
⟦- end⟧

	// Optional.
	Logger *slog.Logger
	// Now is the clock and NewID makes IDs, for tests.
	Now   func() time.Time
	NewID func() string
}

// Service runs the ⟦.PluralHuman⟧ use cases. It is safe for concurrent use.
type Service struct {
	store    Store
	recorder audit.Recorder
⟦- if .Org⟧
	catalog  *authlib.Catalog
	members  orgslib.Memberships
⟦- end⟧
	logger   *slog.Logger
	now      func() time.Time
	newID    func() string
}

// NewService returns a Service.
func NewService(c Config) (*Service, error) {
⟦- if .Org⟧
	if c.Store == nil || c.Recorder == nil || c.Catalog == nil || c.Memberships == nil {
		return nil, errors.New("⟦.Package⟧: invalid service: store, audit recorder, org catalog and memberships are required")
	}
	s := &Service{store: c.Store, recorder: c.Recorder, catalog: c.Catalog, members: c.Memberships, logger: c.Logger, now: c.Now, newID: c.NewID}
⟦- else⟧
	if c.Store == nil || c.Recorder == nil {
		return nil, errors.New("⟦.Package⟧: invalid service: store and audit recorder are required")
	}
	s := &Service{store: c.Store, recorder: c.Recorder, logger: c.Logger, now: c.Now, newID: c.NewID}
⟦- end⟧
	if s.logger == nil {
		s.logger = slog.New(slog.DiscardHandler)
	}
	if s.now == nil {
		s.now = time.Now
	}
	if s.newID == nil {
		s.newID = newID
	}
	return s, nil
}

var idEncoding = base32.NewEncoding("abcdefghijklmnopqrstuvwxyz234567").WithPadding(base32.NoPadding)

// newID returns "⟦.IDPrefix⟧_" and 128 random bits.
func newID() string {
	b := make([]byte, 16)
	_, _ = rand.Read(b) // never fails (crypto/rand)
	return "⟦.IDPrefix⟧_" + idEncoding.EncodeToString(b)
}

// clock returns the time at PostgreSQL's microsecond precision, so a stored
// time equals the one returned.
func (s *Service) clock() time.Time { return s.now().UTC().Truncate(time.Microsecond) }

⟦if .Org -⟧
// member checks that the signed-in user belongs to orgID with a role
// granting permission, and returns the context acting in the organisation.
func (s *Service) member(ctx context.Context, orgID orgslib.ID, permission string) (context.Context, orgslib.Member, error) {
	return orgslib.RequireMember(ctx, s.members, s.catalog, orgID, permission)
}
⟦- else -⟧
// ownerID returns the signed-in user's ID when they hold permission. Only
// users own ⟦.PluralHuman⟧; system and anonymous actors get
// ErrUnauthenticated. Every user holds the permissions through the user
// role, but an API key only when its scopes include them, so a key limited
// to reading can't change anything (ADR-0058); it gets ErrForbidden.
func ownerID(ctx context.Context, permission string) (string, error) {
	a, ok := actor.From(ctx)
	if !ok || a.Kind != actor.KindUser || a.ID == "" {
		return "", ⟦.Package⟧domain.ErrUnauthenticated
	}
	if err := actor.Require(ctx, permission); err != nil {
		return "", ⟦.Package⟧domain.ErrForbidden
	}
	return a.ID, nil
}
⟦- end⟧

// audit records an event after the change it describes; a failed audit
⟦- if .Org⟧
// write is logged, not returned. The recorder adds the actor, organisation
// and request.
⟦- else⟧
// write is logged, not returned. The recorder adds the actor and request.
⟦- end⟧
func (s *Service) audit(ctx context.Context, action, id string, metadata map[string]any) {
	e := audit.Event{Action: action, ResourceType: ⟦quote .Snake⟧, ResourceID: id, Outcome: audit.OutcomeSuccess, Metadata: metadata}
	if err := s.recorder.Record(context.WithoutCancel(ctx), e); err != nil {
		s.logger.ErrorContext(ctx, ⟦quote (print "record " .PluralHuman " audit event")⟧, "action", action, "err", err)
	}
}

// storeError returns the module's own errors as they are and hides the rest,
// such as driver errors, which aren't API (ADR-0018).
func storeError(op string, err error) error {
	known := []error{
		⟦.Package⟧domain.ErrInvalid⟦.Ident⟧, ⟦.Package⟧domain.Err⟦.Ident⟧NotFound,
		⟦range .Uniques⟧⟦$.Package⟧domain.Err⟦$.Ident⟧⟦.Ident⟧Taken, ⟦end⟧⟦.Package⟧domain.Err⟦.Ident⟧VersionConflict,
⟦- if .Org⟧
		orgslib.ErrOrgNotFound, actor.ErrUnauthenticated, actor.ErrForbidden, actor.ErrStepUpRequired,
⟦- end⟧
		page.ErrInvalidSort,
	}
	for _, k := range known {
		if errors.Is(err, k) {
			return err
		}
	}
	return fmt.Errorf("⟦.Package⟧: %s: %v", op, err) //nolint:errorlint // driver errors aren't API (ADR-0018)
}
