package usecase

import (
	"context"
	"fmt"
	"time"

	"gorbital.dev/page"

	"⟦.Module⟧/internal/modules/⟦.Package⟧/domain"
)

// listOptions are the page sizes and sorts List⟦.Plural⟧ accepts.
func listOptions() page.Options {
	return page.Options{
		SortFields:  []string{⟦range $i, $f := .SortFields⟧⟦if $i⟧, ⟦end⟧⟦quote $f⟧⟦end⟧},
		DefaultSort: []page.SortField{{Field: "created_at", Desc: true}},
	}
}

// List⟦.Plural⟧Input selects a page of the signed-in user's ⟦.PluralHuman⟧.
type List⟦.Plural⟧Input struct {
	Page page.Params
⟦- range .Enums⟧
	// ⟦.Ident⟧ keeps ⟦$.PluralHuman⟧ with this ⟦.Human⟧; empty keeps all.
	⟦.Ident⟧ domain.⟦.Ident⟧
⟦- end⟧
}

// cursor is the position a page ended at, with the sort it belongs to, so a
// cursor can't be used with a different sort.
type cursor struct {
	Sort string    `json:"s"`
	Time time.Time `json:"t,omitzero"`
	Text string    `json:"x,omitempty"`
	ID   string    `json:"i"`
}

// List⟦.Plural⟧ returns a page of the signed-in user's ⟦.PluralHuman⟧, sorted by one
// field (newest first by default).
func (s *Service) List⟦.Plural⟧(ctx context.Context, in List⟦.Plural⟧Input) (page.Result[domain.⟦.Ident⟧], error) {
	var none page.Result[domain.⟦.Ident⟧]
	owner, err := ownerID(ctx)
	if err != nil {
		return none, err
	}
	req, err := in.Page.Request(listOptions())
	if err != nil {
		return none, err
	}
	if len(req.Sort) != 1 {
		return none, fmt.Errorf("%w: sort by one field", page.ErrInvalidSort)
	}
⟦- range .Enums⟧
	if in.⟦.Ident⟧ != "" && !in.⟦.Ident⟧.Valid() {
		return none, &domain.ValidationError{Errors: []domain.FieldError{{Field: ⟦quote .Name⟧, Message: ⟦quote .EnumMessage⟧}}}
	}
⟦- end⟧

	q := ListQuery{
		OwnerID: owner,
⟦- range .Enums⟧
		⟦.Ident⟧: in.⟦.Ident⟧,
⟦- end⟧
		Sort: req.Sort[0],
		// One more than the limit shows whether there is a next page.
		Limit: req.Limit + 1,
	}
	sort := sortName(q.Sort)
	if req.Cursor != "" {
		var c cursor
		if err := page.DecodeCursor(req.Cursor, &c); err != nil {
			return none, err
		}
		if c.Sort != sort || c.ID == "" {
			return none, fmt.Errorf("%w: it belongs to a different sort", page.ErrInvalidCursor)
		}
		q.After = &Position{Time: c.Time, Text: c.Text, ID: c.ID}
	}

	items, err := s.store.Select⟦.Plural⟧(ctx, q)
	if err != nil {
		return none, storeError("list", err)
	}
	res := page.Result[domain.⟦.Ident⟧]{Items: items}
	if len(items) > req.Limit {
		res.Items = items[:req.Limit]
		last := res.Items[len(res.Items)-1]
		c := cursor{Sort: sort, ID: last.ID}
		switch q.Sort.Field {
		case "created_at":
			c.Time = last.CreatedAt
		case "updated_at":
			c.Time = last.UpdatedAt
⟦- range .Strings⟧
		case ⟦quote .Name⟧:
			c.Text = last.⟦.Ident⟧
⟦- end⟧
		}
		if res.NextCursor, err = page.EncodeCursor(c); err != nil {
			return none, err
		}
	}
	return res, nil
}

func sortName(f page.SortField) string {
	if f.Desc {
		return "-" + f.Field
	}
	return f.Field
}
