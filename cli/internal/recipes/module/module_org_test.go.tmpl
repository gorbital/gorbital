// Test⟦.Plural⟧AreProtected checks deny by default, membership, organisation
// isolation and API key scopes: an organisation someone isn't a member of
// doesn't exist for them, and another organisation's ⟦.Human⟧ isn't in theirs.
func Test⟦.Plural⟧AreProtected(t *testing.T) {
	app := newApp(t)
	ada, _, adaOrg := signUp(t, app, "ada@example.com")
	bob, _, bobOrg := signUp(t, app, "bob@example.com")
	var website api⟦.Ident⟧
	ada.Post(collection(adaOrg), map[string]any{⟦.BodyFields "Website"⟧}).JSON(t, &website)
	item := collection(adaOrg) + "/" + website.ID

	app.Client().Get(collection(adaOrg)).AssertProblem(t, http.StatusUnauthorized, "unauthenticated")

	for name, res := range map[string]*gorbitaltest.Response{
		"list":                      bob.Get(collection(adaOrg)),
		"create":                    bob.Post(collection(adaOrg), map[string]any{⟦.BodyFields "Mine now"⟧}),
		"get":                       bob.Get(item),
		"update":                    bob.Patch(item, map[string]any{"version": 1, ⟦quote $t.Name⟧: "Mine now"}),
		"delete":                    bob.Delete(item),
		"list in an unknown org":    bob.Get(collection("org_mfrggzdfmztwq2lkmfrggzdfmy")),
		"list with a malformed org": bob.Get(collection("not-an-org")),
	} {
		t.Run("non-member "+name, func(t *testing.T) {
			res.AssertProblem(t, http.StatusNotFound, "org_not_found")
		})
	}

	bobItem := collection(bobOrg) + "/" + website.ID
	bob.Get(bobItem).AssertProblem(t, http.StatusNotFound, "⟦.Snake⟧_not_found")
	bob.Patch(bobItem, map[string]any{"version": 1, ⟦quote $t.Name⟧: "Mine now"}).AssertProblem(t, http.StatusNotFound, "⟦.Snake⟧_not_found")
	bob.Delete(bobItem).AssertProblem(t, http.StatusNotFound, "⟦.Snake⟧_not_found")
	var bobs api⟦.Ident⟧Page
	bob.Get(collection(bobOrg)).JSON(t, &bobs)
	if len(bobs.Items) != 0 {
		t.Errorf("another organisation's list = %+v, want none", bobs.Items)
	}

	readOnly := app.Client().WithHeader("Authorization", "Bearer "+apiKey(t, ada, usecase.PermRead))
	readOnly.Get(item).AssertStatus(t, http.StatusOK)
	readOnly.Post(collection(adaOrg), map[string]any{⟦.BodyFields "By a key"⟧}).AssertProblem(t, http.StatusForbidden, "forbidden")
	readOnly.Patch(item, map[string]any{"version": 1, ⟦quote $t.Name⟧: "By a key"}).AssertProblem(t, http.StatusForbidden, "forbidden")
	readOnly.Delete(item).AssertProblem(t, http.StatusForbidden, "forbidden")
}

func TestList⟦.Plural⟧Pages(t *testing.T) {
	app := newApp(t)
	ada, _, adaOrg := signUp(t, app, "ada@example.com")
	ada.Post(collection(adaOrg), map[string]any{⟦.BodyFields "Website"⟧}).AssertStatus(t, http.StatusCreated)
	ada.Post(collection(adaOrg), map[string]any{⟦.BodyFields "Docs"⟧⟦.BodyChoice⟧}).AssertStatus(t, http.StatusCreated)

	var titles []string
	cursor := ""
	for range 3 {
		var p api⟦.Ident⟧Page
		ada.Get(collection(adaOrg)+"?limit=1&sort=⟦$t.Name⟧&cursor="+url.QueryEscape(cursor)).JSON(t, &p)
		for _, item := range p.Items {
			titles = append(titles, item.⟦$t.Ident⟧)
		}
		if cursor = p.NextCursor; cursor == "" {
			break
		}
	}
	if want := []string{"Docs", "Website"}; !slices.Equal(titles, want) {
		t.Errorf("pages sorted by ⟦$t.Name⟧ = %v, want %v", titles, want)
	}

	var first api⟦.Ident⟧Page
	ada.Get(collection(adaOrg) + "?limit=1").JSON(t, &first)
	ada.Get(collection(adaOrg)+"?sort=⟦$t.Name⟧&cursor="+url.QueryEscape(first.NextCursor)).AssertProblem(t, http.StatusBadRequest, "invalid_cursor")
	ada.Get(collection(adaOrg)+"?sort=org_id").AssertProblem(t, http.StatusBadRequest, "invalid_sort")
⟦- if .HasEnums⟧

	var filtered api⟦.Ident⟧Page
	ada.Get(collection(adaOrg) + "?⟦$e.Name⟧=⟦$e.LastValue.Value⟧").JSON(t, &filtered)
	if len(filtered.Items) != 1 || filtered.Items[0].⟦$t.Ident⟧ != "Docs" {
		t.Errorf("list with ⟦$e.Name⟧=⟦$e.LastValue.Value⟧ = %+v, want Docs only", filtered.Items)
	}
⟦- end⟧
}

func TestUpdateAndDelete⟦.Ident⟧(t *testing.T) {
	app := newApp(t)
	ada, adaID, adaOrg := signUp(t, app, "ada@example.com")
	var website api⟦.Ident⟧
	ada.Post(collection(adaOrg), map[string]any{⟦.BodyFields "Website"⟧}).JSON(t, &website)
	item := collection(adaOrg) + "/" + website.ID

	ada.Patch(item, map[string]any{⟦quote $t.Name⟧: "No version"}).AssertProblem(t, http.StatusUnprocessableEntity, "validation_failed")
	ada.Patch(item, map[string]any{"version": 2, ⟦quote $t.Name⟧: "Too new"}).AssertProblem(t, http.StatusConflict, "⟦.Snake⟧_version_conflict")

	res := ada.Patch(item, map[string]any{"version": 1, ⟦quote $t.Name⟧: "Renamed"⟦if .HasEnums⟧, ⟦quote $e.Name⟧: ⟦quote $e.LastValue.Value⟧⟦end⟧})
	res.AssertStatus(t, http.StatusOK)
	var updated api⟦.Ident⟧
	res.JSON(t, &updated)
	if updated.⟦$t.Ident⟧ != "Renamed"⟦if .HasEnums⟧ || updated.⟦$e.Ident⟧ != ⟦quote $e.LastValue.Value⟧⟦end⟧ || updated.Version != 2 {
		t.Errorf("updated = %+v, want the new values and version 2", updated)
	}
	// Changing ⟦.A⟧ ⟦.Human⟧ with the version it already had is a conflict.
	ada.Patch(item, map[string]any{"version": 1, ⟦quote $t.Name⟧: "Again"}).AssertProblem(t, http.StatusConflict, "⟦.Snake⟧_version_conflict")

	ada.Delete(item).AssertStatus(t, http.StatusNoContent)
	ada.Get(item).AssertProblem(t, http.StatusNotFound, "⟦.Snake⟧_not_found")
	ada.Delete(item).AssertProblem(t, http.StatusNotFound, "⟦.Snake⟧_not_found")

	// Every event names the member and the organisation.
	rows, err := app.App().Deps().DB.Query(context.Background(),
		`SELECT action, actor_id, coalesce(org_id, '') FROM audit_events WHERE resource_type = '⟦.Snake⟧' AND resource_id = $1 ORDER BY id`, website.ID)
	if err != nil {
		t.Fatal(err)
	}
	defer rows.Close()
	var trail []string
	for rows.Next() {
		var action, actorID, orgID string
		if err := rows.Scan(&action, &actorID, &orgID); err != nil {
			t.Fatal(err)
		}
		trail = append(trail, action+" by "+actorID+" in "+orgID)
	}
	var want []string
	for _, action := range []string{usecase.ActionCreated, usecase.ActionUpdated, usecase.ActionDeleted} {
		want = append(want, action+" by "+adaID+" in "+adaOrg)
	}
	if !slices.Equal(trail, want) {
		t.Errorf("audit trail = %v, want %v", trail, want)
	}
}

// TestPurgingAnOrganisationDeletesIts⟦.Plural⟧ checks the migration's foreign key:
// the orgs_purge job deletes an organisation once its restore period ends,
// and its ⟦.PluralHuman⟧ go with it.
func TestPurgingAnOrganisationDeletesIts⟦.Plural⟧(t *testing.T) {
	app := newApp(t)
	ada, _, adaOrg := signUp(t, app, "ada@example.com")
	ada.Post(collection(adaOrg), map[string]any{⟦.BodyFields "Website"⟧}).AssertStatus(t, http.StatusCreated)

	// Every organisation's rows, whether or not the app has row-level security.
	ctx := postgres.WithoutRowLevelSecurity(context.Background(), "test: purge")
	db := app.App().Deps().DB
	if _, err := db.Exec(ctx, `DELETE FROM orgs WHERE id = $1`, adaOrg); err != nil {
		t.Fatal(err)
	}
	var left int
	if err := db.QueryRow(ctx, `SELECT count(*) FROM ⟦.Table⟧ WHERE org_id = $1`, adaOrg).Scan(&left); err != nil || left != 0 {
		t.Errorf("⟦.PluralHuman⟧ left after purging the organisation = %d, %v; want 0", left, err)
	}
}
