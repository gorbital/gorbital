// Service runs the ⟦.PluralHuman⟧ use cases. It is safe for concurrent use.
type Service struct {
	store    Store
⟦- if .Custom⟧
	policy   Policy
⟦- end⟧
	recorder audit.Recorder
	logger   *slog.Logger
	now      func() time.Time
