// NewService returns a Service storing ⟦.PluralHuman⟧ in store, asking policy who
// may see and change them, and recording changes in recorder. All three may
// be nil while the OpenAPI document is exported, when no use case runs.
func NewService(store Store, policy Policy, recorder audit.Recorder, logger *slog.Logger) *Service {
	if logger == nil {
		logger = slog.New(slog.DiscardHandler)
	}
	return &Service{store: store, policy: policy, recorder: recorder, logger: logger, now: time.Now, newID: newID}
}
⟦- else⟧

// NewService returns a Service storing ⟦.PluralHuman⟧ in store and recording
// changes in recorder. Both may be nil while the OpenAPI document is
// exported, when no use case runs.
func NewService(store Store, recorder audit.Recorder, logger *slog.Logger) *Service {
	if logger == nil {
		logger = slog.New(slog.DiscardHandler)
	}
	return &Service{store: store, recorder: recorder, logger: logger, now: time.Now, newID: newID}
}
⟦- end⟧

var idEncoding = base32.NewEncoding("abcdefghijklmnopqrstuvwxyz234567").WithPadding(base32.NoPadding)

// newID returns "⟦.IDPrefix⟧_" and 128 random bits.
func newID() string {
	b := make([]byte, 16)
	_, _ = rand.Read(b) // never fails (crypto/rand)
	return "⟦.IDPrefix⟧_" + idEncoding.EncodeToString(b)
}

// clock returns the time at PostgreSQL's microsecond precision, so a stored
// time equals the one returned.
func (s *Service) clock() time.Time { return s.now().UTC().Truncate(time.Microsecond) }

⟦- if .Org⟧
// memberID returns the member acting in ⟦.ScopeVar⟧, the ⟦.ScopeName⟧ in the
// request's path: a user, or the ⟦.ScopeName⟧'s own service account.
// ⟦.ScopeGuard⟧ checked the membership and the permission, and left the
// ⟦.ScopeName⟧ in the actor; a request acting in no ⟦.ScopeName⟧ or in
// another one, such as on a route without the guard, gets
// ErrUnauthenticated.
func memberID(ctx context.Context, ⟦.ScopeVar⟧ string) (string, error) {
	a, ok := actor.From(ctx)
	if !ok || a.ID == "" || ⟦.ScopeVar⟧ == "" || a.OrgID != ⟦.ScopeVar⟧ {
		return "", domain.ErrUnauthenticated
	}
	return a.ID, nil
}

// audit records an event after the change it describes; a failed audit
// write is logged, not returned. The recorder adds the actor, the
// ⟦.ScopeName⟧ and the request.
⟦- else if .Public⟧
// audit records an event after the change it describes; a failed audit
// write is logged, not returned. The recorder adds the actor and request.
⟦- else if .Custom⟧
// actorID returns who is acting, which the policy usually compares against.
// The routes let only authenticated callers through.
func actorID(ctx context.Context) (string, error) {
	a, ok := actor.From(ctx)
	if !ok || a.ID == "" {
		return "", domain.ErrUnauthenticated
	}
	return a.ID, nil
}

// audit records an event after the change it describes; a failed audit
// write is logged, not returned. The recorder adds the actor and request.
⟦- else⟧
// ownerID returns the signed-in user, who owns the ⟦.PluralHuman⟧ an operation
// reads or changes. The routes let only authenticated callers through; a
// service account's API key owns no ⟦.PluralHuman⟧.
func ownerID(ctx context.Context) (string, error) {
	a, ok := actor.From(ctx)
	if !ok || a.Kind != actor.KindUser || a.ID == "" {
		return "", domain.ErrUnauthenticated
	}
	return a.ID, nil
}

// audit records an event after the change it describes; a failed audit
// write is logged, not returned. The recorder adds the actor and request.
⟦- end⟧
func (s *Service) audit(ctx context.Context, action, id string, metadata map[string]any) {
	e := audit.Event{Action: action, ResourceType: ⟦quote .Snake⟧, ResourceID: id, Outcome: audit.OutcomeSuccess, Metadata: metadata}
	if err := s.recorder.Record(context.WithoutCancel(ctx), e); err != nil {
		s.logger.ErrorContext(ctx, ⟦quote (print "record " .PluralHuman " audit event")⟧, "action", action, "err", err)
	}
}

// storeError returns the module's own errors as they are and hides the
// rest, such as driver errors, which aren't API.
func storeError(op string, err error) error {
	known := []error{
⟦- if .Custom⟧
		// An unwritten policy is a refusal of its own, answered with 501.
		gorbital.ErrNotImplemented,
⟦- end⟧
		domain.ErrInvalid⟦.Ident⟧, domain.Err⟦.Ident⟧NotFound,
		⟦range .Uniques⟧domain.Err⟦$.Ident⟧⟦.Ident⟧Taken, ⟦end⟧domain.Err⟦.Ident⟧VersionConflict,
		page.ErrInvalidSort,
	}
	for _, k := range known {
		if errors.Is(err, k) {
			return err
		}
	}
	return fmt.Errorf("⟦.Package⟧: %s: %v", op, err) //nolint:errorlint // driver errors aren't API
}
