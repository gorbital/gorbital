// ⟦.Ident⟧Response is ⟦.A⟧ ⟦.Human⟧ as the API returns it.
type ⟦.Ident⟧Response struct {
	ID string `json:"id" example:"⟦.IDPrefix⟧_mfrggzdfmztwq2lkmfrggzdfmy"`
⟦- range .Fields⟧
	⟦.Ident⟧ string `json:"⟦.Name⟧"⟦if .IsEnum⟧ enum:"⟦.EnumTag⟧"⟦end⟧`
⟦- end⟧
⟦- if .Org⟧
	CreatedBy string `json:"created_by" example:"usr_mfrggzdfmztwq2lkmfrggzdfmy" doc:"The member who created it"`
⟦- else if .HasCreatedBy⟧
	CreatedBy string `json:"created_by" example:"usr_mfrggzdfmztwq2lkmfrggzdfmy" doc:"Who created it; the policy decides what that grants"`
⟦- end⟧
	Version   int64     `json:"version" example:"1" doc:"Increases with every change; send it back when updating"`
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

type ⟦.Var⟧Output struct {
	Body ⟦.Ident⟧Response
}

// ⟦.Var⟧IDInput is the path of the routes on one ⟦.Human⟧.
type ⟦.Var⟧IDInput struct {
⟦- if .Org⟧
	⟦.ScopeParamField⟧ string `path:"⟦.ScopePathParam⟧" maxLength:"64" example:"⟦.ScopeIDExample⟧"`
⟦- end⟧
	ID string `path:"id" maxLength:"64" example:"⟦.IDPrefix⟧_mfrggzdfmztwq2lkmfrggzdfmy"`
}

func toResponse(⟦.Var⟧ domain.⟦.Ident⟧) ⟦.Ident⟧Response {
	return ⟦.Ident⟧Response{
		ID: ⟦.Var⟧.ID,
⟦- range .Fields⟧
		⟦.Ident⟧: ⟦if .IsEnum⟧string(⟦$.Var⟧.⟦.Ident⟧)⟦else⟧⟦$.Var⟧.⟦.Ident⟧⟦end⟧,
⟦- end⟧
⟦- if .HasCreatedBy⟧
		CreatedBy: ⟦.Var⟧.CreatedBy,
⟦- end⟧
		Version:   ⟦.Var⟧.Version,
		CreatedAt: ⟦.Var⟧.CreatedAt,
		UpdatedAt: ⟦.Var⟧.UpdatedAt,
	}
}

// fieldErrors lists invalid fields, found in location ("body" or "query");
// module.go maps the other errors.
func fieldErrors(err error, location string) error {
	var invalid *domain.ValidationError
	if !errors.As(err, &invalid) {
		return err
	}
	p := httpx.NewProblem(http.StatusUnprocessableEntity, "validation_failed", ⟦quote (print "the " .Human " is not valid")⟧)
	for _, f := range invalid.Errors {
		p.Errors = append(p.Errors, httpx.FieldError{Location: location + "." + f.Field, Message: f.Message})
	}
	return p
}
