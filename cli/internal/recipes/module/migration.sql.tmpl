-- +goose Up
CREATE TABLE ⟦.Table⟧ (
    ⟦.Pad "id"⟧ text        PRIMARY KEY,
    -- The organisation; NOT NULL, so row-level security covers the table.
    ⟦.Pad "org_id"⟧ text        NOT NULL,
    -- The member who created it, for display and audit. Access comes only
