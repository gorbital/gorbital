package domain

import (
	"errors"
	"strings"
)

// Errors of the ⟦.PluralHuman⟧ use cases. module.go maps each to an HTTP status
// and a problem code, which are public API.
var (
	// ErrUnauthenticated reports an operation without a signed-in user: a
	// service account's API key owns no ⟦.PluralHuman⟧.
	ErrUnauthenticated = errors.New(⟦quote (print .Package ": a signed-in user is required")⟧)

	// ErrInvalid⟦.Ident⟧ reports invalid fields. The error is a
	// *ValidationError.
	ErrInvalid⟦.Ident⟧ = errors.New(⟦quote (print .Package ": invalid " .Human)⟧)

	// Err⟦.Ident⟧NotFound reports ⟦.A⟧ ⟦.Human⟧ that doesn't exist or belongs to
	// someone else. The two aren't told apart, so IDs can't be probed.
	Err⟦.Ident⟧NotFound = errors.New(⟦quote (print .Package ": " .Human " not found")⟧)
⟦range .Uniques⟧
	// Err⟦$.Ident⟧⟦.Ident⟧Taken reports ⟦.A⟧ ⟦.Human⟧ the owner already uses,
	// ignoring case.
	Err⟦$.Ident⟧⟦.Ident⟧Taken = errors.New(⟦quote (print $.Package ": " $.Human " " .Human " is already taken")⟧)
⟦end⟧
	// Err⟦.Ident⟧VersionConflict reports an update to a version that is no
	// longer current.
	Err⟦.Ident⟧VersionConflict = errors.New(⟦quote (print .Package ": " .Human " was changed since it was read")⟧)
)

// FieldError is one invalid field.
type FieldError struct {
	Field   string
	Message string
}

// ValidationError lists every invalid field of ⟦.A⟧ ⟦.Human⟧.
type ValidationError struct {
	Errors []FieldError
}

func (e *ValidationError) Error() string {
	parts := make([]string, len(e.Errors))
	for i, f := range e.Errors {
		parts[i] = f.Field + " " + f.Message
	}
	return ⟦quote (print .Package ": invalid " .Human ": ")⟧ + strings.Join(parts, "; ")
}

// Unwrap returns ErrInvalid⟦.Ident⟧.
func (e *ValidationError) Unwrap() error { return ErrInvalid⟦.Ident⟧ }
