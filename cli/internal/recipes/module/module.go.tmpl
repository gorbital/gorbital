// Module returns the ⟦.PluralHuman⟧ module. main.go adds it with every other
// module through modules.All. Error codes and permission names are public
// API: add new ones, never change existing ones.
func Module() gorbital.Module {
	return gorbital.Module{
		Name: ⟦quote .Package⟧,
		Errors: []httpx.Mapping{
			{Err: domain.ErrUnauthenticated, Status: http.StatusUnauthorized, Code: "unauthenticated", Detail: "authentication is required"},
			{Err: domain.ErrInvalid⟦.Ident⟧, Status: http.StatusUnprocessableEntity, Code: "validation_failed", Detail: "the ⟦.Human⟧ is not valid"},
			{Err: domain.Err⟦.Ident⟧NotFound, Status: http.StatusNotFound, Code: "⟦.Snake⟧_not_found", Detail: "no ⟦.Human⟧ of yours has this ID"},
⟦- range .Uniques⟧
			{Err: domain.Err⟦$.Ident⟧⟦.Ident⟧Taken, Status: http.StatusConflict, Code: "⟦$.Snake⟧_⟦.Name⟧_taken", Detail: "you already have ⟦$.A⟧ ⟦$.Human⟧ with this ⟦.Human⟧"},
⟦- end⟧
