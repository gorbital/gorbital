# orb:begin mail (managed by `orb add mail`: the email provider's secrets)
# SMTP server, such as email-smtp.eu-west-1.amazonaws.com (Amazon SES),
# smtp.postmarkapp.com or smtp.gmail.com. Needed when email goes through SMTP
# (always in production). The sender name, address and reply-to are runtime
# settings: PUT /ops/settings/mail.from_email.
SMTP_HOST=
# 587 with starttls (recommended), 465 with tls, or none for a local server.
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# orb:end mail
