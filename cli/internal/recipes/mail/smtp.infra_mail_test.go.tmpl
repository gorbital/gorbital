package app_test

import (
	"os"
	"strings"
	"testing"

	"gorbital.dev/config"

	"⟦.Module⟧/internal/app"
)

// The email provider's side of the tests. `orb add mail` replaces this file
// together with infra_mail.go (ADR-0037); the other tests use these values,
// so they pass with any provider.
var (
	// mailProviderEnv configures the provider well enough to start in
	// production.
	mailProviderEnv = map[string]string{"SMTP_HOST": "smtp.example.com"}
	// mailProviderRequired is the variable LoadConfig asks for when email
	// goes through the provider and mailProviderEnv isn't set.
	mailProviderRequired = "SMTP_HOST"
	// mailProviderName and mailProviderDetails are what GET /ops/mail
	// reports about the provider without mailProviderEnv.
	mailProviderName    = "smtp"
	mailProviderDetails = map[string]any{"host": "missing", "port": "587", "tls": "starttls", "auth": "none"}
)

func TestMailProviderConfiguration(t *testing.T) {
	load := func(env map[string]string) (app.Config, error) {
		base := map[string]string{"AUTH_ENCRYPTION_KEYS": testEncryptionKeys, "MAIL_DELIVERY": "provider", "SMTP_HOST": "smtp.example.com"}
		for k, v := range env {
			base[k] = v
		}
		return app.LoadConfig(config.Source{Getenv: func(k string) string { return base[k] }, ReadFile: os.ReadFile})
	}
	tests := []struct {
		name    string
		env     map[string]string
		wantErr string
	}{
		{"server only", nil, ""},
		{"TLS on port 465", map[string]string{"SMTP_PORT": "465", "SMTP_TLS": "tls"}, ""},
		{"username and password", map[string]string{"SMTP_USERNAME": "user", "SMTP_PASSWORD": "secret"}, ""},
		{"bad port", map[string]string{"SMTP_PORT": "smtp"}, "SMTP_PORT"},
		{"port out of range", map[string]string{"SMTP_PORT": "70000"}, "SMTP_PORT"},
		{"bad encryption", map[string]string{"SMTP_TLS": "ssl"}, "SMTP_TLS"},
		{"username without password", map[string]string{"SMTP_USERNAME": "user"}, "SMTP_PASSWORD"},
		{"no server", map[string]string{"SMTP_HOST": ""}, "SMTP_HOST"},
	}
	for _, tt := range tests {
		_, err := load(tt.env)
		switch {
		case tt.wantErr == "" && err != nil:
			t.Errorf("%s: LoadConfig() error = %v", tt.name, err)
		case tt.wantErr != "" && (err == nil || !strings.Contains(err.Error(), tt.wantErr)):
			t.Errorf("%s: LoadConfig() error = %v, want one mentioning %s", tt.name, err, tt.wantErr)
		}
	}

	cfg, err := load(nil)
	if err != nil || cfg.Mail.SMTPPort != 587 || string(cfg.Mail.SMTPTLS) != "starttls" {
		t.Errorf("LoadConfig() defaults = port %d, TLS %q, %v; want 587 with starttls", cfg.Mail.SMTPPort, cfg.Mail.SMTPTLS, err)
	}
}
