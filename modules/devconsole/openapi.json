    "/_dev/requests/stream": {
      "get": {
        "operationId": "dev-requests-stream",
        "summary": "Live requests",
        "description": "Server-Sent Events: `retry: 3000`, then `event: request` with a Request for each new item, `event: dropped` with a StreamDropped when the client was too slow, `: keep-alive` comments every 15 seconds, and a final `event: end` with a StreamEnd after 30 minutes or when the app shuts down. EventSource can't send the Authorization header: read the stream with fetch. At most 8 streams at once.",
        "tags": [
          "Dev console"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token (code unauthorized)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Host header isn't localhost, 127.0.0.1 or [::1] with the app's port, or the connection isn't local (code forbidden)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "This app doesn't serve the endpoint (code not_found)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "The console already serves its maximum number of streams (code rate_limited)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
