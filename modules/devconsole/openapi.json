  "components": {
    "securitySchemes": {
      "devConsoleToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "The token orb dev prints (DEV_CONSOLE_TOKEN)"
      }
    },
    "schemas": {
      "Index": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The paths this app serves, sorted"
          }
        },
        "required": [
          "endpoints"
        ]
      },
      "App": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Service name"
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "go_version": {
            "type": "string"
          },
          "env": {
            "type": "string",
            "description": "APP_ENV"
          },
          "libraries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Library"
            },
            "description": "gorbital library modules linked into the binary"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The API's areas: OpenAPI tags"
          },
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            },
            "description": "Empty in apps without jobs"
          },
          "settings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Setting"
            },
            "description": "Empty in apps without runtime settings"
          },
          "flags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Flag"
            },
            "description": "Empty in apps without feature flags"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionCatalog"
            },
            "description": "Empty in apps without authentication"
          }
        },
        "required": [
          "name",
          "version",
          "go_version",
          "env",
          "libraries",
          "modules",
          "jobs",
          "settings",
          "flags",
          "permissions"
        ]
      },
      "Library": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "replaced": {
            "type": "boolean",
            "description": "Replaced by a local directory or another module"
          }
        },
        "required": [
          "path",
          "version"
        ]
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "schedule": {
            "type": "string",
            "description": "Cron expression or descriptor; empty for on-demand jobs"
          },
          "modified": {
            "type": "boolean"
          },
          "next_run_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "description",
          "enabled",
          "schedule",
          "modified"
        ]
      },
      "Setting": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "value": {
            "description": "Effective value (any JSON)"
          },
          "default": {
            "description": "Declared default (any JSON)"
          },
          "modified": {
            "type": "boolean"
          },
          "org_overridable": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "group",
          "description",
          "kind",
          "value",
          "default",
          "modified",
          "org_overridable"
        ]
      },
      "Flag": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "client": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "default": {
            "type": "boolean"
          },
          "percentage": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Rollout percentage; null without a rollout"
          },
          "targets": {
            "type": "integer",
            "description": "Organisation and user IDs in allow and deny lists"
          },
          "modified": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "group",
          "description",
          "client",
          "enabled",
          "default",
          "percentage",
          "targets",
          "modified"
        ]
      },
      "PermissionCatalog": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          }
        },
        "required": [
          "name",
          "permissions",
          "roles"
        ]
      },
      "Permission": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ]
      },
      "Role": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "description",
          "permissions"
        ]
