{
  "openapi": "3.1.0",
  "info": {
    "title": "gorbital dev console",
    "version": "1",
    "description": "Development-only APIs of a gorbital app (ADR-0065), served when APP_ENV is development and DEV_CONSOLE_TOKEN is set; orb dev sets a new token on every run and prints it. Every request needs a Host header of localhost, 127.0.0.1 or [::1] with the app's port, a connection from a loopback address, and Authorization: Bearer <token>. Responses carry no CORS headers and say Cache-Control: no-store. Fields may be added."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "security": [
    {
      "devConsoleToken": []
    }
  ],
  "tags": [
    {
      "name": "Dev console"
    }
  ],
  "paths": {
    "/_dev/": {
      "get": {
        "operationId": "dev-index",
        "summary": "Endpoints",
        "description": "The console endpoints this app serves. Minimal apps have no mail, migrations or jobs.",
        "tags": [
          "Dev console"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Index"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong token (code unauthorized)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Host header isn't localhost, 127.0.0.1 or [::1] with the app's port, or the connection isn't local (code forbidden)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "This app doesn't serve the endpoint (code not_found)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
